{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrialGPT prepared criterion example",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "input", "target"],
  "allOf": [
    {
      "if": {"properties": {"input": {"properties": {"criterion_type": {"const": "inclusion"}}, "required": ["criterion_type"]}}},
      "then": {"properties": {"target": {"properties": {"label": {"enum": ["included", "not included", "not enough information", "not applicable"]}}}}},
      "else": {"properties": {"target": {"properties": {"label": {"enum": ["excluded", "not excluded", "not enough information", "not applicable"]}}}}}
    }
  ],
  "properties": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_id", "patient_id", "trial_id", "source_expert_sentences"],
      "properties": {
        "annotation_id": {"type": "integer"},
        "patient_id": {"type": "string"},
        "trial_id": {"type": "string"},
        "source_expert_sentences": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_type", "criterion_text", "sentences"],
      "properties": {
        "criterion_type": {"enum": ["inclusion", "exclusion"]},
        "criterion_text": {"type": "string", "minLength": 1},
        "sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {"type": "integer", "minimum": 0},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence_sentence_ids"],
      "properties": {
        "label": {
          "enum": [
            "included",
            "not included",
            "excluded",
            "not excluded",
            "not enough information",
            "not applicable"
          ]
        },
        "evidence_sentence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
